# Malaka Task Management API — example environment
ENV=dev
PORT=8080

# Database: sqlite (default) or postgres
DB_DRIVER=sqlite
DATABASE_URL=./data/malaka.db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_LIFETIME=5m

# PostgreSQL and Docker Compose
POSTGRES_PASSWORD=replace-with-local-password
# DB_DRIVER=postgres
# DATABASE_URL=postgres://malaka:replace-with-local-password@localhost:5432/malaka?sslmode=disable

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Auth: must be at least 32 characters
JWT_SECRET=replace-with-a-random-secret-32-chars-min

# Idempotency key retention window
IDEMPOTENCY_TTL=24h

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
